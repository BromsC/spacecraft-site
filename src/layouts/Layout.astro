---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import { getExhibition, getSiteSettings } from '../lib/content';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  // Home page only: header hidden until #landing is scrolled past.
  autohideHeader?: boolean;
}

const site = await getSiteSettings();
const ex = await getExhibition();
const { title, description = site.tagline, autohideHeader = false } = Astro.props;
const pageTitle = title ? `${title} — ${site.siteTitle}` : site.siteTitle;
// Absolute URLs for canonical / Open Graph (`site` is set in astro.config.mjs).
const origin = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, origin).href;
const ogImage = ex.logo ? new URL(url(ex.logo), origin).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link
      rel="preload"
      href={url('/fonts/ABCArealSuperfamilyVariable.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="color-scheme" content="light" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader autohide={autohideHeader} />
    <main id="main">
      <slot />
    </main>
  </body>
</html>
