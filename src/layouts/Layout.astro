---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import { getSiteSettings } from '../lib/content';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  // Home page only: header hidden until #landing is scrolled past.
  autohideHeader?: boolean;
}

const site = await getSiteSettings();
const { title, description = site.tagline, autohideHeader = false } = Astro.props;
const pageTitle = title ? `${title} — ${site.siteTitle}` : site.siteTitle;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link
      rel="preload"
      href={url('/fonts/ABCArealSuperfamilyVariable.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="color-scheme" content="light" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader autohide={autohideHeader} />
    <main id="main">
      <slot />
    </main>
  </body>
</html>
