---
import { render } from 'astro:content';
import type { Artist } from '../lib/content';
import { renderCaption } from '../lib/content';
import { url } from '../lib/url';

// Artist block, one centred column on every viewport (Figma "MacBook Pro 14 - 3" → "- 6" and the
// phone frames, as revised by Caspar's screenshots). Visual order, set with CSS `order` only:
//   title → intro (text before the first sub-heading) → main image → rest of the text →
//   second image → caption → links / back link (slot).
// `.feature__body` is `display: contents`, so the rendered paragraphs/headings are grid items and
// the intro is picked out with `:has()` — no JS, no text splitting. Without a sub-heading the main
// image goes after the first paragraph. See global.css "#current / artist page".
interface Props {
  artist: Artist;
  id?: string;
  // h1 on the artist's own page, h2 on the home page.
  headingLevel?: 1 | 2;
}

const { artist, id, headingLevel = 2 } = Astro.props;
const Heading = headingLevel === 1 ? 'h1' : 'h2';
const { name, period, mainImage, btsImage, btsCaption } = artist.data;
const { Content } = await render(artist);
// Caption only belongs to the second image.
const caption = btsImage ? await renderCaption(btsCaption) : undefined;
const hasExtra = Astro.slots.has('default');
---

<section id={id} class="section feature">
  {
    mainImage && (
      <img class="feature__image" src={url(mainImage)} alt={name} width="726" height="726" decoding="async" />
    )
  }
  {
    btsImage && (
      <img
        class="feature__second"
        src={url(btsImage)}
        alt={name}
        width="720"
        height="822"
        loading="lazy"
        decoding="async"
      />
    )
  }
  {caption && <div class="feature__caption prose" set:html={caption} />}
  <Heading class="feature__title">
    {name}
    {period && (<><br />{period}</>)}
  </Heading>
  <div class="feature__body prose">
    <Content />
  </div>
  {
    hasExtra && (
      <div class="feature__extra">
        <slot />
      </div>
    )
  }
</section>
