---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import ArtistFeature from '../components/ArtistFeature.astro';
import ExhibitionLists from '../components/ExhibitionLists.astro';
import {
  byStatus,
  getArtists,
  getCurrentArtist,
  getExhibition,
  presentingLine,
  withPeriod,
} from '../lib/content';
import { url } from '../lib/url';

const ex = await getExhibition();
const artists = await getArtists();
const current = getCurrentArtist(artists);
---

<Layout autohideHeader>
  {
    ex.logo && (
      <div class="loader" aria-hidden="true">
        <img
          class="loader__logo"
          src={url(ex.logo)}
          alt=""
          width="1494"
          height="840"
          fetchpriority="high"
          decoding="sync"
        />
      </div>
    )
  }

  <script is:inline>
    // Loading overlay: the logo for 800 ms on every load, then a 500 ms fade, then it's removed.
    // CSS shows it only with the `js` class, so no-JS visitors never see it. The 800 ms start once
    // the logo has loaded (at most 2 s after this runs, so a slow image can't hold the page).
    (function () {
      var loader = document.querySelector('.loader');
      if (!loader) return;
      var remove = function () {
        loader.remove();
      };
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return remove();

      var started = false;
      var start = function () {
        if (started) return;
        started = true;
        setTimeout(function () {
          loader.addEventListener('transitionend', remove, { once: true });
          setTimeout(remove, 1500);
          loader.classList.add('is-leaving');
        }, 800);
      };
      var logo = loader.querySelector('img');
      if (!logo || logo.complete) return start();
      logo.addEventListener('load', start);
      logo.addEventListener('error', start);
      setTimeout(start, 2000);
    })();
  </script>

  <section id="landing" class="landing">
    <div class="landing__text">
      <h1 class="landing__title">{ex.title}</h1>
      {
        (ex.datesLine || ex.venue) && (
          <p class="landing__dates">
            {ex.datesLine && withPeriod(ex.datesLine)}
            {ex.datesLine && ex.venue && (<>{' '}<br /></>)}
            {ex.venue && withPeriod(ex.venue)}
          </p>
        )
      }
      {artists.length > 0 && <p class="landing__presenting">{presentingLine(ex.presentingPrefix, artists)}</p>}
    </div>
    {
      current && (
        <a class="landing__current" href="#current">
          <span class="landing__label">{ex.currentLabel}</span>
          <Arrow direction="down" class="landing__arrow" />
        </a>
      )
    }
  </section>

  {current && <ArtistFeature id="current" artist={current} />}

  <ExhibitionLists
    id="exhibitions"
    groups={[
      { key: 'previous', heading: 'Previous exhibitions:', artists: byStatus(artists, 'previous') },
      { key: 'upcoming', heading: 'Upcoming exhibitions:', artists: byStatus(artists, 'upcoming') },
    ]}
  />
</Layout>
