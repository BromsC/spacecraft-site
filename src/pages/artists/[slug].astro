---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getArtists } from '../../lib/content';
import { url } from '../../lib/url';

export const getStaticPaths = (async () => {
  const artists = await getArtists();
  return artists.map((artist) => ({ params: { slug: artist.id }, props: { artist } }));
}) satisfies GetStaticPaths;

const { artist } = Astro.props;
const { name, role, shortBio, portrait, gallery, links } = artist.data;
const { Content } = await render(artist);
---

<Layout title={name} description={shortBio}>
  <article class="container section">
    <p><a href={url('/artists')}>← All artists</a></p>
    <div class="split">
      <div>
        <h1>{name}</h1>
        {role && <p class="muted">{role}</p>}
        {shortBio && <p class="lead">{shortBio}</p>}
        <div class="prose">
          <Content />
        </div>
        {
          links.length > 0 && (
            <ul class="links">
              {links.map((link) => (
                <li>
                  <a href={link.url} rel="noopener">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
      {portrait && <img class="portrait" src={url(portrait)} alt={`Portrait of ${name}`} width="800" height="1000" />}
    </div>

    {
      gallery.length > 0 && (
        <section class="section">
          <h2>Works</h2>
          <div class="gallery">
            {gallery.map((item) => (
              <figure>
                <img src={url(item.image)} alt={item.caption ?? ''} loading="lazy" width="1200" height="800" />
                {item.caption && <figcaption class="muted">{item.caption}</figcaption>}
              </figure>
            ))}
          </div>
        </section>
      )
    }
  </article>
</Layout>
