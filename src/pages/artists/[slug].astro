---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import ArtistFeature from '../../components/ArtistFeature.astro';
import { getArtists } from '../../lib/content';
import { url } from '../../lib/url';

export const getStaticPaths = (async () => {
  const artists = await getArtists();
  return artists.map((artist) => ({ params: { slug: artist.id }, props: { artist } }));
}) satisfies GetStaticPaths;

const { artist } = Astro.props;
const { name, links } = artist.data;
---

<Layout title={name}>
  <ArtistFeature artist={artist} headingLevel={1}>
    {
      links.length > 0 && (
        <ul class="links">
          {links.map((link) => (
            <li>
              <a href={link.url} rel="noopener">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
    <p class="back-link"><a href={url('/')}>← Home</a></p>
  </ArtistFeature>
</Layout>
